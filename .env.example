# ============================================
# GOOGLE CLOUD / BIGQUERY
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_BRONZE=weather_bronze
GCP_DATASET_SILVER=weather_silver
GCP_DATASET_GOLD=weather_gold
GCP_REGION=us-east1

# Path to GCP service account JSON
# Mount via docker-compose volumes: ~/.config/gcloud:/opt/airflow/.config
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/.config/gcp-key.json

# ============================================
# AIRFLOW
# ============================================
AIRFLOW__CORE__FERNET_KEY=testveryverysecretferneykeythatisbase64encoded_
AIRFLOW_HOME=/opt/airflow

# ============================================
# OPEN-METEO API
# ============================================
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ============================================
# PIPELINE
# ============================================
# Regiões monitoradas (separadas por vírgula)
PIPELINE_REGIONS=São Paulo,Rio de Janeiro,Belo Horizonte,Salvador,Fortaleza

# Retentativo de chamadas API
PIPELINE_RETRIES=3
PIPELINE_RETRY_DELAY=60  # segundos

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
